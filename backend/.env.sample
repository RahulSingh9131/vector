VECTOR_PRIMARY.ENV="local"

VECTOR_SERVER.PORT="8080"
VECTOR_SERVER.READ_TIMEOUT="30"
VECTOR_SERVER.WRITE_TIMEOUT="30"
VECTOR_SERVER.IDLE_TIMEOUT="60"
VECTOR_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

VECTOR_DATABASE.HOST="localhost"
VECTOR_DATABASE.PORT="5432"
VECTOR_DATABASE.USER="postgres"
VECTOR_DATABASE.PASSWORD=""
VECTOR_DATABASE.NAME="vector"
VECTOR_DATABASE.SSL_MODE="disable"
VECTOR_DATABASE.MAX_OPEN_CONNS="25"
VECTOR_DATABASE.MAX_IDLE_CONNS="25"
VECTOR_DATABASE.CONN_MAX_LIFETIME="300"
VECTOR_DATABASE.CONN_MAX_IDLE_TIME="300"

VECTOR_AUTH.SECRET_KEY="secret"

VECTOR_INTEGRATION.RESEND_API_KEY="resend_key"

VECTOR_REDIS.ADDRESS="redis://localhost:6379"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
VECTOR_OBSERVABILITY.SERVICE_NAME="vector"
VECTOR_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
VECTOR_OBSERVABILITY.LOGGING.LEVEL="debug"
VECTOR_OBSERVABILITY.LOGGING.FORMAT="console"
VECTOR_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
VECTOR_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VECTOR_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
VECTOR_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
VECTOR_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
VECTOR_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
VECTOR_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
VECTOR_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
VECTOR_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis"